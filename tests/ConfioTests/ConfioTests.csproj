<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TomlynIsReflectionEnabledByDefault>false</TomlynIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Confio/Confio.csproj" />
    <ProjectReference Include="../../src/ConfioGenerator/ConfioGenerator.csproj" OutputItemType="Analyzer" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Host 的 EventLog 8/9 资产需要此传递依赖补充。 -->
    <PackageReference Include="System.Threading.AccessControl" Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="IncludeJsonSourceGenerator" AfterTargets="ResolveReferences">
    <ItemGroup>
      <None Include="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'System.Text.Json.SourceGeneration'"
            Link="System.Text.Json.SourceGeneration.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
