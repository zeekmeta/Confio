<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- Framework 使用 App.config 设置验收开关，强制验证静态元数据消费。 -->
    <AppContextSwitchOverrides value="System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault=false;Tomlyn.TomlSerializer.IsReflectionEnabledByDefault=false" />
  </runtime>
</configuration>
