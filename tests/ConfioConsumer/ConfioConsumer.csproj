<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net462;net47;net471;net472;net48;net481;net8.0;net9.0;net10.0</TargetFrameworks>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TomlynIsReflectionEnabledByDefault>false</TomlynIsReflectionEnabledByDefault>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
    <PublishAot Condition="'$(RuntimeIdentifier)' != '' And '$(IsAotCompatible)' == 'true'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Confio/Confio.csproj" />
    <ProjectReference Include="../../src/ConfioGenerator/ConfioGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../ConfioConsumerModels/ConfioConsumerModels.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Host 的 EventLog 8/9 资产需要此传递依赖补充。 -->
    <PackageReference Include="System.Threading.AccessControl" Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'" />
  </ItemGroup>
</Project>
